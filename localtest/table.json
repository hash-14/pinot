{
  "tableName": "streams_daily",
  "tableType": "OFFLINE",
  "segmentsConfig": {
    "timeColumnName": "day_dt",
    "segmentPushType": "APPEND",
    "replication": "1",
    "retentionTimeUnit": "DAYS",
    "retentionTimeValue": "3650"
  },
  "tenants": {},
  "routing": {
    "segmentPrunerTypes": ["time"]
  },
  "tableIndexConfig": {
    "loadMode": "MMAP",
    "sortedColumn": ["artist_id"],
    "invertedIndexColumns": ["country_code", "song_id", "device"],
    "rangeIndexColumns": ["all_streams"],
    "bloomFilterConfigs": {
      "song_id": { "fpp": 0.001 },
      "song_name": { "fpp": 0.001 }
    },
    "starTreeIndexConfigs": [
      {
        "dimensionsSplitOrder": ["day_dt", "country_code", "artist_id"],
        "skipStarNodeCreationForDimensions": [],
        "functionColumnPairs": ["SUM__all_streams", "SUM__full_streams", "SUM__total_seconds_streamed"],
        "maxLeafRecords": 10000
      }
    ]
  },
  "metadata": {
    "customConfigs": {
      "remote.query.enabled": "true",
      "remote.query.base.uri": "file:///deepstore/remote/streams_daily/"
    }
  }
}
